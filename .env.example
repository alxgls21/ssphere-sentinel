# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Agent token HMAC pepper (dedicated; do not reuse DJANGO_SECRET_KEY)
AGENT_TOKEN_PEPPER=change-me-to-a-long-random-pepper

# Database (PostgreSQL)
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
