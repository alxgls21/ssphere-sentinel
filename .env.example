# SSphere Sentinel server configuration (Docker Compose and native installs).
#
# Copy to .env and replace every "change-me" value. Generate secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
# Never commit .env. Commented settings show their defaults.

# --- Django ------------------------------------------------------------------
# Production: false. Local development: true (plain-HTTP cookies, static files
# from runserver; the example secret key is only accepted with DEBUG on).
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Hostnames this server answers to, comma-separated. Never "*" in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins (with scheme) allowed to submit admin forms when HTTPS is terminated
# in front of Django, e.g. by a reverse proxy or Cloudflare Tunnel.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sentinel.example.com
# DJANGO_LOG_LEVEL=INFO

# --- HTTPS and reverse proxy (docs/security.md) ------------------------------
# Session and CSRF cookies are HTTPS-only unless DJANGO_DEBUG=true. Set both
# to false only to try the admin over plain http://.
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# Redirect http:// to https:// in Django. Only enable it when Gunicorn can see
# the original scheme (FORWARDED_ALLOW_IPS), otherwise requests loop.
# DJANGO_SECURE_SSL_REDIRECT=false
# HSTS in seconds. Start small (3600) once HTTPS works for every client.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
# Reverse proxies (IPs or CIDRs) allowed to set X-Forwarded-Proto; read by
# Gunicorn. Use "*" only if nothing but the proxy can reach Gunicorn.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Gunicorn worker processes.
# WEB_CONCURRENCY=2

# --- Agent tokens --------------------------------------------------------------
# Dedicated HMAC pepper for agent token hashes; do not reuse DJANGO_SECRET_KEY.
# Changing it later invalidates every agent token.
AGENT_TOKEN_PEPPER=change-me-to-a-long-random-pepper

# --- Monitoring ----------------------------------------------------------------
# Server liveness: seconds without a heartbeat before effective status is offline.
# Default 90 pairs with the agent default heartbeat interval of 30 seconds.
SENTINEL_OFFLINE_THRESHOLD=90

# Network measurement history retention (days). Cleanup via:
#   python manage.py purge_network_measurements
SENTINEL_NETWORK_MEASUREMENT_RETENTION_DAYS=30

# Oldest measured_at accepted for delayed measurements (days, capped at retention).
SENTINEL_NETWORK_MEASUREMENT_MAX_AGE_DAYS=8

# SNMP polls and interface samples retention (days). Cleanup via:
#   python manage.py purge_snmp_data
SENTINEL_SNMP_RETENTION_DAYS=30

# Oldest measured_at accepted for delayed SNMP polls (days, capped at retention).
SENTINEL_SNMP_MAX_AGE_DAYS=8

# Absent Docker containers retention (days). Cleanup via:
#   python manage.py purge_absent_docker_containers
SENTINEL_DOCKER_ABSENT_CONTAINER_RETENTION_DAYS=30

# --- Database (PostgreSQL) -----------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-db-password
# localhost for a native PostgreSQL; Docker Compose overrides it with "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Docker Compose only ---------------------------------------------------------
# Address and port the web service is published on. Use 127.0.0.1 behind a
# reverse proxy or Cloudflare Tunnel so plain HTTP is not exposed.
# SENTINEL_HTTP_BIND=0.0.0.0
# SENTINEL_HTTP_PORT=8000
# The Cloudflare Tunnel token goes in .env.tunnel, not here (compose.tunnel.yml).
