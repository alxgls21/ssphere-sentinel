# SSphere Sentinel server configuration (Docker Compose and native installs).
#
# Copy to .env and replace every "change-me" value. Generate secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
# Never commit .env. Commented settings show their defaults.

# --- Django ------------------------------------------------------------------
# Production: false. Local development: true (plain-HTTP cookies, static files
# from runserver; the example secret key is only accepted with DEBUG on).
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Hostnames this server answers to, comma-separated. Never "*" in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins (with scheme) allowed to submit admin forms when HTTPS is terminated
# in front of Django, e.g. by a reverse proxy or Cloudflare Tunnel.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sentinel.example.com
# DJANGO_LOG_LEVEL=INFO

# --- HTTPS and reverse proxy (docs/security.md) ------------------------------
# Session and CSRF cookies are HTTPS-only unless DJANGO_DEBUG=true. Set both
# to false only to try the admin over plain http://.
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# Redirect http:// to https:// in Django. Only enable it when Gunicorn can see
# the original scheme (FORWARDED_ALLOW_IPS), otherwise requests loop.
# DJANGO_SECURE_SSL_REDIRECT=false
# HSTS in seconds. Start small (3600) once HTTPS works for every client.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
# Reverse proxies (IPs or CIDRs) allowed to set X-Forwarded-Proto; read by
# Gunicorn. Use "*" only if nothing but the proxy can reach Gunicorn.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Gunicorn worker processes.
# WEB_CONCURRENCY=2

# --- Agent tokens --------------------------------------------------------------
# Dedicated HMAC pepper for agent token hashes; do not reuse DJANGO_SECRET_KEY.
# Changing it later invalidates every agent token.
AGENT_TOKEN_PEPPER=change-me-to-a-long-random-pepper

# --- Monitoring ----------------------------------------------------------------
# Server liveness: seconds without a heartbeat before effective status is offline.
# Default 90 pairs with the agent default heartbeat interval of 30 seconds.
# The same window decides whether a server's resource reading (CPU, memory, disk)
# and its Docker report are current: older ones no longer count towards health.
SENTINEL_OFFLINE_THRESHOLD=90

# Network measurement history retention (days). Cleanup via:
#   python manage.py purge_network_measurements
SENTINEL_NETWORK_MEASUREMENT_RETENTION_DAYS=30

# Oldest measured_at accepted for delayed measurements (days, capped at retention).
SENTINEL_NETWORK_MEASUREMENT_MAX_AGE_DAYS=8

# SNMP polls and interface samples retention (days). Cleanup via:
#   python manage.py purge_snmp_data
SENTINEL_SNMP_RETENTION_DAYS=30

# Oldest measured_at accepted for delayed SNMP polls (days, capped at retention).
SENTINEL_SNMP_MAX_AGE_DAYS=8

# Server CPU/memory/disk history (the charts): one sample per server per
# SAMPLE_SECONDS (5, 6, 10, 12, 15, 20, 30, 60 or 300), kept for
# RETENTION_DAYS (2-365; the chart ranges need at least 1 day). Cleanup via:
#   python manage.py purge_telemetry_samples
SENTINEL_TELEMETRY_RETENTION_DAYS=7
SENTINEL_TELEMETRY_SAMPLE_SECONDS=60

# Absent Docker containers retention (days). Cleanup via:
#   python manage.py purge_absent_docker_containers
SENTINEL_DOCKER_ABSENT_CONTAINER_RETENTION_DAYS=30

# --- Console (web UI API, /api/v1/console/; docs/security.md) -------------------
# Console accounts are Django users with the "Can sign in to the monitoring
# console" permission, limited to the customers and sites granted to them.
# Console session lifetime in seconds (default 12 hours; 300 to 2592000).
# SENTINEL_CONSOLE_SESSION_SECONDS=43200
# Failed sign-ins allowed per account before it is locked, and for how long.
# SENTINEL_CONSOLE_LOGIN_MAX_ATTEMPTS=5
# SENTINEL_CONSOLE_LOGIN_LOCKOUT_SECONDS=900
# Health thresholds the console reports (display defaults, not alert rules).
# SENTINEL_THRESHOLD_RESOURCE_WARN_PERCENT=80
# SENTINEL_THRESHOLD_RESOURCE_CRIT_PERCENT=95
# SENTINEL_THRESHOLD_PROBE_LOSS_WARN_PERCENT=2
# SENTINEL_THRESHOLD_PROBE_LATENCY_WARN_MS=150
# SENTINEL_THRESHOLD_TARGET_CRIT_FAILURES=3

# --- Alerts and email (docs/server-deployment.md) --------------------------------
# Incidents are kept for INCIDENT_RETENTION_DAYS (7-3650) after they end, with
# their history; open ones are never removed. The record of each email is kept
# for NOTIFICATION_RETENTION_DAYS (or until its incident goes). Cleanup via:
#   python manage.py purge_incidents
#   python manage.py purge_notifications
# SENTINEL_INCIDENT_RETENTION_DAYS=365
# SENTINEL_NOTIFICATION_RETENTION_DAYS=90
# Incident emails are off until SENTINEL_SMTP_HOST is set. Then start the
# notifier too: COMPOSE_PROFILES=notifications. The password reaches the
# notifier service only, never the database.
# SENTINEL_SMTP_HOST=smtp.example.com
# SENTINEL_SMTP_PORT=587
# starttls (usually 587), tls (implicit TLS, usually 465), or none (a relay on
# a trusted network, without credentials).
# SENTINEL_SMTP_SECURITY=starttls
# SENTINEL_SMTP_USER=sentinel@example.com
# In single quotes, Compose and the shell take a value as written ($, #, <); not
# one that holds a ' or ends with a \ (choose another password).
# SENTINEL_SMTP_PASSWORD='change-me-smtp-password'
# Seconds for each SMTP connection and command (1-60).
# SENTINEL_SMTP_TIMEOUT=10
# SENTINEL_EMAIL_FROM='Sentinel <sentinel@example.com>'
# The console's address, for the links in the emails (none without it).
# SENTINEL_CONSOLE_URL=https://sentinel.example.com
# An email not sent within this many hours is given up (1-168).
# SENTINEL_NOTIFICATION_MAX_AGE_HOURS=24
# COMPOSE_PROFILES=notifications

# --- Websites (docs/server-deployment.md) -----------------------------------------
# A domain is verified (a TXT record its owner adds) before any of its websites is
# monitored. The domain-verifier service answers the verifications asked for in the
# console, from each domain's own name servers (DNS, port 53, to the internet):
# COMPOSE_PROFILES=web-monitoring (with notifications: notifications,web-monitoring).

# --- Database (PostgreSQL) -----------------------------------------------------
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-db-password
# localhost for a native PostgreSQL; Docker Compose overrides it with "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Separate database logins (docs/server-deployment.md): no Sentinel container
# holds the superuser's password. POSTGRES_PASSWORD then moves out of this file
# into the one SENTINEL_BOOTSTRAP_ENV_FILE names, the migration login's password
# goes into the one SENTINEL_MIGRATE_ENV_FILE names, and this file gets
# SENTINEL_DB_ROLES=separate and SENTINEL_DB_PASSWORD.

# --- Docker Compose only ---------------------------------------------------------
# PostgreSQL major version of the Compose stack, with its volume and data layout
# (deploy/postgres/). 18 is for new installations. An installation that already
# has data in the PostgreSQL 16 volume must not set it: without this line it
# stays on PostgreSQL 16 until it is migrated by the procedure in
# docs/server-deployment.md.
SENTINEL_POSTGRES=18
# Authorizes PostgreSQL 18 to create an empty database: add it for the very first
# start of a new installation (or when restoring a dump into a new volume) and
# remove it afterwards. Without it a missing database is an error instead of a
# silently empty one. See docs/server-deployment.md.
# SENTINEL_POSTGRES_INITIALIZE=true
# Address and port Sentinel (the proxy service: the console, the APIs and the
# admin) is published on. Use 127.0.0.1 behind a reverse proxy or Cloudflare
# Tunnel so plain HTTP is not exposed.
# SENTINEL_HTTP_BIND=0.0.0.0
# SENTINEL_HTTP_PORT=8000
# The Cloudflare Tunnel token goes in .env.tunnel, not here (compose.tunnel.yml).
