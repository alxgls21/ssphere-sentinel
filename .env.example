# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Agent token HMAC pepper (dedicated; do not reuse DJANGO_SECRET_KEY)
AGENT_TOKEN_PEPPER=change-me-to-a-long-random-pepper

# Server liveness: seconds without a heartbeat before effective status is offline.
# Default 90 pairs with the agent default heartbeat interval of 30 seconds.
SENTINEL_OFFLINE_THRESHOLD=90

# Network measurement history retention (days). Cleanup via:
#   python manage.py purge_network_measurements
SENTINEL_NETWORK_MEASUREMENT_RETENTION_DAYS=30

# Oldest measured_at accepted for delayed measurements (days, capped at retention).
SENTINEL_NETWORK_MEASUREMENT_MAX_AGE_DAYS=8

# Absent Docker containers retention (days). Cleanup via:
#   python manage.py purge_absent_docker_containers
SENTINEL_DOCKER_ABSENT_CONTAINER_RETENTION_DAYS=30

# Database (PostgreSQL)
# For local virtualenv development use localhost.
# Docker Compose overrides POSTGRES_HOST to "db" for the web service.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
