# SSphere Sentinel agent environment: /etc/ssphere-sentinel-agent/agent.env
#
# Install with root-only permissions; systemd reads it before starting the
# agent as the unprivileged service account:
#   sudo install -m 0600 -o root -g root agent.env.example /etc/ssphere-sentinel-agent/agent.env
#
# Never put the token in the unit file, on the command line, or in a URL.

# Sentinel server base URL. Use https://; redirects are not followed.
SENTINEL_URL=https://sentinel.example.com
# Token printed once when the agent was created in Sentinel.
SENTINEL_AGENT_TOKEN=replace-with-the-agent-token

# Optional settings (defaults shown).
# SENTINEL_HEARTBEAT_INTERVAL=30
# SENTINEL_LOG_LEVEL=INFO

# Network monitoring: targets file readable by the service account, e.g.
#   sudo install -m 0640 -o root -g sentinel-agent targets.json /etc/ssphere-sentinel-agent/network_targets.json
# SENTINEL_NETWORK_TARGETS_FILE=/etc/ssphere-sentinel-agent/network_targets.json
# SENTINEL_NETWORK_MAX_CONCURRENT_PROBES=4
# SENTINEL_QUEUE_MAX_MEASUREMENTS=10000
# SENTINEL_QUEUE_MAX_AGE_SECONDS=604800
# The queue path is set by the unit (persistent state directory):
# SENTINEL_QUEUE_PATH=/var/lib/ssphere-sentinel-agent/network-queue.sqlite3

# SNMP monitoring (optional; needs the agent installed with the [snmp] extra,
# see docs/snmp.md). The credentials file holds community strings and SNMPv3
# keys: root-owned, mode 0640 with group sentinel-agent (or 0600 for the agent's
# own user). Sentinel never sees its content.
# SENTINEL_SNMP_DEVICES_FILE=/etc/ssphere-sentinel-agent/snmp_devices.json
# SENTINEL_SNMP_CREDENTIALS_FILE=/etc/ssphere-sentinel-agent/snmp_credentials.json
# SENTINEL_SNMP_MAX_CONCURRENT_POLLS=4
# SENTINEL_SNMP_QUEUE_MAX_POLLS=10000
# SENTINEL_SNMP_QUEUE_MAX_BYTES=536870912

# Docker monitoring through a filtering socket proxy instead of the raw socket
# (see docs/agent-deployment.md):
# DOCKER_HOST=tcp://127.0.0.1:2375
